{
  "info": {
    "name": "Student API - Basic",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Các request cơ bản để xem dữ liệu và thử PATCH/DELETE."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "studentId", "value": "" }
  ],
  "item": [
    {
      "name": "GET - Danh sách sinh viên",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/students"
      }
    },
    {
      "name": "PATCH - Cập nhật điểm",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"score\": 8.5\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/students/{{studentId}}"
      }
    },
    {
      "name": "DELETE - Xóa sinh viên",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/students/{{studentId}}"
      }
    }
  ]
}
